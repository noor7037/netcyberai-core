    {
      "key": "d.u04.l2",
      "kind": "pattern",
      "title": {
        "en": "Talking about the future",
        "hi": "भविष्य की बात"
      },
      "minutes": 9,
      "steps": [
        {
          "type": "pattern",
          "title": {
            "en": "Will, going to, and the present continuous for plans",
            "hi": "Will, going to, और योजना के लिए present continuous"
          },
          "visual": "timeline",
          "examples": [
            {
              "en": "I think it will rain tomorrow.",
              "hi": "मुझे लगता है कल बारिश होगी। (अंदाज़ा)",
              "time": "future"
            },
            {
              "en": "Wait, I will help you with that box.",
              "hi": "रुको, मैं वह डिब्बा उठाने में मदद करती हूँ। (अभी का फ़ैसला)",
              "time": "now"
            },
            {
              "en": "We are going to paint the classroom walls.",
              "hi": "हम कक्षा की दीवारें रंगने वाले हैं। (पहले से तय इरादा)",
              "time": "future"
            },
            {
              "en": "Look at those clouds. It is going to rain.",
              "hi": "वो बादल देखो। बारिश होने वाली है। (सबूत देखकर)",
              "time": "future"
            },
            {
              "en": "I am meeting the principal at ten tomorrow.",
              "hi": "कल दस बजे मेरी प्रधानाचार्य से मुलाक़ात है। (तय समय)",
              "time": "future"
            }
          ],
          "note": {
            "en": "Will: a guess or a quick decision. Going to: a plan you already have. Present continuous: a fixed time and place.",
            "hi": "Will: अंदाज़ा या तुरंत फ़ैसला। Going to: पहले से इरादा। Present continuous: समय और जगह तय।"
          }
        },
        {
          "type": "build",
          "items": [
            {
              "key": "d.u04.l2.b-going",
              "tiles": [
                "We are",
                "plant",
                "on Sunday.",
                "going to",
                "trees"
              ],
              "answer": "We are going to plant trees on Sunday."
            },
            {
              "key": "d.u04.l2.b-meeting",
              "tiles": [
                "tomorrow.",
                "I am",
                "meeting",
                "Salma",
                "at the library"
              ],
              "answer": "I am meeting Salma at the library tomorrow."
            }
          ]
        },
        {
          "type": "choose",
          "items": [
            {
              "key": "d.u04.l2.p-will",
              "prompt": {
                "en": "The phone is ringing. I ___ answer it."
              },
              "options": [
                {
                  "text": "am going to"
                },
                {
                  "text": "was"
                },
                {
                  "text": "will"
                }
              ],
              "answer": 2,
              "why": {
                "en": "A decision made right now: will.",
                "hi": "अभी लिया गया फ़ैसला: will।"
              }
            },
            {
              "key": "d.u04.l2.p-going",
              "prompt": {
                "en": "Arjun has bought paint. He ___ paint the door."
              },
              "options": [
                {
                  "text": "will"
