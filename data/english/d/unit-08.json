          "title": {
            "en": "Indirect questions",
            "hi": "Indirect सवाल"
          },
          "visual": "question_flip",
          "examples": [
            {
              "en": "Where is platform 3?",
              "hi": "प्लेटफ़ॉर्म 3 कहाँ है?"
            },
            {
              "en": "Could you tell me where platform 3 is?",
              "hi": "क्या आप बता सकते हैं कि प्लेटफ़ॉर्म 3 कहाँ है?"
            },
            {
              "en": "When does the train leave?",
              "hi": "ट्रेन कब छूटती है?"
            },
            {
              "en": "Do you know when the train leaves?",
              "hi": "क्या आपको पता है ट्रेन कब छूटती है?"
            },
            {
              "en": "Is the train on time?",
              "hi": "क्या ट्रेन समय पर है?"
            },
            {
              "en": "Could you tell me if the train is on time?",
              "hi": "क्या आप बता सकते हैं कि ट्रेन समय पर है या नहीं?"
            }
          ],
          "note": {
            "en": "After \"Could you tell me\" or \"Do you know\", the order is normal: where the platform is, not where is the platform. For yes or no questions, use if.",
            "hi": "Could you tell me / Do you know के बाद सामान्य क्रम: where the platform is। हाँ-ना सवाल में if लगाओ।"
          }
        },
