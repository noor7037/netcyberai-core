      },
      "minutes": 8,
      "steps": [
        {
          "type": "pattern",
          "title": {
            "en": "Past continuous and past simple",
            "hi": "Past continuous और past simple"
          },
          "visual": "timeline",
          "examples": [
            {
              "en": "I was walking to school at eight o'clock.",
              "hi": "आठ बजे मैं स्कूल जा रही थी। (लंबा काम)",
              "time": "past"
            },
            {
              "en": "I was walking to school when it started to rain.",
              "hi": "मैं स्कूल जा रही थी, तभी बारिश शुरू हुई।",
              "time": "past"
            },
            {
              "en": "While Papa was cooking, the phone rang.",
              "hi": "जब पापा खाना बना रहे थे, फ़ोन बजा।",
              "time": "past"
            },
            {
              "en": "We were playing cricket when the ball broke a window.",
              "hi": "हम क्रिकेट खेल रहे थे, तभी गेंद से खिड़की टूट गई।",
              "time": "past"
            },
            {
              "en": "Now we are laughing about it.",
              "hi": "अब हम उस पर हँसते हैं।",
              "time": "now"
            }
          ],
          "note": {
            "en": "The longer action: was or were + -ing. The short action that breaks in: past simple. Join them with when or while.",
            "hi": "लंबा काम: was/were + -ing। बीच में आया छोटा काम: past simple। when या while से जोड़ो।"
          }
