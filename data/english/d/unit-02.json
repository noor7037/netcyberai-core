    {
      "key": "d.u02.l2",
      "kind": "pattern",
      "title": {
        "en": "Have you ever …?",
        "hi": "क्या तुमने कभी …?"
      },
      "minutes": 8,
      "steps": [
        {
          "type": "pattern",
          "title": {
            "en": "The present perfect: have or has + done",
            "hi": "Present perfect: have/has + तीसरी फ़ॉर्म"
          },
          "visual": "timeline",
          "examples": [
            {
              "en": "I have visited the city twice.",
              "hi": "मैं दो बार शहर जा चुकी हूँ। (कब, यह ज़रूरी नहीं)",
              "time": "past"
            },
            {
              "en": "Have you ever seen the sea?",
              "hi": "क्या तुमने कभी समुद्र देखा है?",
              "time": "past"
            },
            {
              "en": "Arjun has never flown in a plane.",
              "hi": "अर्जुन कभी हवाई जहाज़ में नहीं बैठा।",
              "time": "past"
            },
            {
              "en": "I have already finished my homework.",
              "hi": "मैं अपना होमवर्क पहले ही ख़त्म कर चुकी हूँ।",
              "time": "now"
            },
            {
              "en": "Salma has not packed her bag yet.",
              "hi": "सलमा ने अभी तक बैग नहीं बाँधा है।",
              "time": "now"
            }
          ],
          "note": {
            "en": "Use it for life experiences when the time is not said. Ever and yet go in questions; never means not at any time.",
            "hi": "जीवन के अनुभव, जब समय न बताया जाए। ever और yet सवालों में; never यानी कभी नहीं।"
          }
        },
        {
          "type": "build",
          "items": [
            {
              "key": "d.u02.l2.b-ever",
              "tiles": [
                "you",
                "seen",
                "ever",
                "the sea?",
                "Have"
              ],
              "answer": "Have you ever seen the sea?"
            },
            {
