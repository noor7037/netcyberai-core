                  "text": "has"
                },
                {
                  "text": "is"
                },
                {
                  "text": "have"
                }
              ],
              "answer": 0,
              "why": {
                "en": "He, she and a single name take has.",
                "hi": "He, she या एक नाम के साथ has।"
