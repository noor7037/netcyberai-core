          ],
          "learner": 1,
          "turns": [
            {
              "role": 0,
              "en": "You went to the health centre with Dadi. What did the doctor say?"
            },
            {
              "role": 1,
              "en": "She said that Dadi had a mild fever."
            },
            {
              "role": 0,
              "en": "Did she give any medicine?"
            },
            {
              "role": 1,
              "en": "Yes. She explained that Dadi should take the tablets after meals."
            },
            {
              "role": 0,
              "en": "Anything else?"
            },
            {
              "role": 1,
              "en": "She warned us that Dadi needed rest and lots of water."
            },
            {
              "role": 0,
              "en": "When should we go back?"
            },
            {
              "role": 1,
              "en": "She said that we should come back if the fever didn't go down in two days."
            }
          ],
          "partner": {
            "goal": "Act as a parent asking what the doctor said. Ask about the problem, the medicine, the advice and the next visit. Gently recast direct speech into reported speech.",
            "must_use": [
              "said that",
