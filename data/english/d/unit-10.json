        {
          "type": "roleplay",
          "title": {
            "en": "Tell Mummy what the doctor said",
            "hi": "मम्मी को बताओ डॉक्टर ने क्या कहा"
          },
          "scene": {
            "place": "home",
            "pics": [
              {
                "pic": "🏠",
                "x": 85,
                "y": 15,
                "size": 2
              },
