    {
      "key": "d.u10.l2",
      "kind": "pattern",
      "title": {
        "en": "She said that …",
        "hi": "उसने कहा कि …"
      },
      "minutes": 9,
      "steps": [
        {
          "type": "pattern",
          "title": {
            "en": "Reported speech: the tense steps back",
            "hi": "Reported speech: काल एक क़दम पीछे"
          },
          "visual": "cards",
          "examples": [
            {
              "en": "\"I am tired.\" → Ravi said that he was tired.",
              "hi": "\"मैं थका हूँ।\" → रवि ने कहा कि वह थका था।"
            },
            {
              "en": "\"I live in Rampur.\" → Meera said that she lived in Rampur.",
              "hi": "\"मैं रामपुर में रहती हूँ।\" → मीरा ने कहा कि वह रामपुर में रहती थी।"
            },
            {
              "en": "\"I will help you.\" → Arjun said that he would help me.",
              "hi": "\"मैं तुम्हारी मदद करूँगा।\" → अर्जुन ने कहा कि वह मेरी मदद करेगा।"
            },
            {
              "en": "\"I can swim.\" → Salma said that she could swim.",
              "hi": "\"मैं तैर सकती हूँ।\" → सलमा ने कहा कि वह तैर सकती थी।"
            },
            {
              "en": "\"We are planting trees.\" → They said that they were planting trees.",
              "hi": "\"हम पेड़ लगा रहे हैं।\" → उन्होंने कहा कि वे पेड़ लगा रहे थे।"
            }
          ],
          "note": {
            "en": "After said, step back: am or is to was, are to were, will to would, can to could. Change I and my to he, she, his or her.",
            "hi": "Said के बाद एक क़दम पीछे: am/is → was, are → were, will → would, can → could। I/my को he/she/his/her करो।"
          }
        },
        {
          "type": "build",
          "items": [
            {
              "key": "d.u10.l2.b-was",
              "tiles": [
                "that",
                "She",
                "was hungry.",
                "she",
                "said"
              ],
              "answer": "She said that she was hungry."
            },
            {
              "key": "d.u10.l2.b-would",
              "tiles": [
                "that",
                "later.",
                "said",
                "he would",
                "He",
                "come"
              ],
              "answer": "He said that he would come later."
            }
          ]
        },
        {
          "type": "choose",
          "items": [
            {
              "key": "d.u10.l2.p-were",
              "prompt": {
                "en": "\"We are ready.\" → They said that they ___ ready."
              },
              "options": [
                {
                  "text": "will"
                },
                {
                  "text": "are"
                },
                {
                  "text": "were"
                }
              ],
              "answer": 2,
              "why": {
                "en": "Are steps back to were.",
                "hi": "Are पीछे जाकर were बनता है।"
              }
            },
            {
              "key": "d.u10.l2.p-could",
              "prompt": {
                "en": "\"I can fix it.\" → Papa said that he ___ fix it."
              },
              "options": [
                {
                  "text": "can"
                },
                {
                  "text": "will"
                },
                {
                  "text": "could"
                }
              ],
              "answer": 2,
              "why": {
                "en": "Can steps back to could.",
                "hi": "Can पीछे जाकर could बनता है।"
              }
            }
          ]
        },
