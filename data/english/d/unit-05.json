      "steps": [
        {
          "type": "pattern",
          "title": {
            "en": "Three ways to give advice",
            "hi": "सलाह देने के तीन तरीक़े"
          },
          "visual": "cards",
          "examples": [
            {
              "en": "You should drink more water in the heat.",
              "hi": "गर्मी में तुम्हें ज़्यादा पानी पीना चाहिए।"
            },
            {
              "en": "You shouldn't study all night before an exam.",
              "hi": "परीक्षा से पहले पूरी रात नहीं पढ़ना चाहिए।"
            },
            {
              "en": "We ought to respect our elders.",
              "hi": "हमें बड़ों का आदर करना चाहिए। (कर्तव्य जैसी सलाह)"
            },
            {
              "en": "You had better take an umbrella, or you will get wet.",
              "hi": "छाता ले लो, वरना भीग जाओगे। (चेतावनी)"
            },
            {
              "en": "Should I tell the teacher?",
              "hi": "क्या मुझे टीचर को बताना चाहिए?"
            }
          ],
          "note": {
            "en": "After should, ought to and had better, use the base verb: should go, not should goes. Had better is a strong warning.",
            "hi": "Should, ought to, had better के बाद क्रिया का मूल रूप: should go। Had better एक मज़बूत चेतावनी है।"
          }
        },
