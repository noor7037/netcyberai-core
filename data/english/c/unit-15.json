    {
      "key": "c.u15.l2",
      "kind": "pattern",
      "title": { "en": "would like; polite requests", "hi": "would like: विनम्र अनुरोध" },
      "minutes": 7,
      "steps": [
        {
          "type": "pattern",
          "title": { "en": "Polite ways to ask and invite", "hi": "पूछने और बुलाने के विनम्र तरीक़े" },
          "visual": "builder",
          "examples": [
            {
              "en": "I would like to speak to Salma, please.",
              "hi": "मैं सलमा से बात करना चाहूँगी।",
              "parts": [
                { "text": "I", "role": "who" },
                { "text": "would like", "role": "do" },
                { "text": "to speak to Salma,", "role": "what" },
                { "text": "please.", "role": "other" }
              ],
              "pic": "☎️"
            },
            {
              "en": "Would you like to come to my house?",
              "hi": "क्या तुम मेरे घर आना चाहोगी?",
              "parts": [
                { "text": "Would", "role": "ask" },
                { "text": "you", "role": "who" },
                { "text": "like", "role": "do" },
                { "text": "to come", "role": "what" },
                { "text": "to my house?", "role": "where" }
              ],
              "pic": "🏠"
            },
            {
              "en": "I'd like two kilos of rice, please.",
              "hi": "मुझे दो किलो चावल चाहिए।",
              "parts": [
                { "text": "I'd", "role": "who" },
                { "text": "like", "role": "do" },
                { "text": "two kilos of rice,", "role": "what" },
                { "text": "please.", "role": "other" }
              ],
              "pic": "🍚"
            },
            {
              "en": "Would you like some tea? Yes, please.",
              "hi": "क्या आप चाय लेंगे? हाँ, ज़रूर।",
              "parts": [
                { "text": "Would", "role": "ask" },
                { "text": "you", "role": "who" },
                { "text": "like", "role": "do" },
                { "text": "some tea?", "role": "what" },
                { "text": "Yes, please.", "role": "other" }
              ],
              "pic": "🍵"
            },
            {
              "en": "Could you ask her to call me back?",
              "hi": "क्या आप उससे मुझे वापस फ़ोन करने को कहेंगी?",
              "parts": [
                { "text": "Could", "role": "ask" },
                { "text": "you", "role": "who" },
                { "text": "ask her", "role": "do" },
                { "text": "to call me back?", "role": "what" }
              ],
              "pic": "📱"
            }
          ],
          "note": {
            "en": "I would like (I'd like) is a polite I want. Would you like …? is a polite offer or invitation.",
            "hi": "I would like (I'd like) = विनम्र 'मुझे चाहिए'। Would you like …? = विनम्र पेशकश या न्योता।"
          }
        },
        {
          "type": "build",
          "items": [
            {
