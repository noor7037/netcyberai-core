              "pic": "💧",
              "tiles": ["water?", "like", "some", "Would", "you"],
              "answer": "Would you like some water?"
            },
            {
              "key": "c.u15.l2.b-message",
              "hi": "मैं एक संदेश छोड़ना चाहूँगा/चाहूँगी।",
              "pic": "📨",
              "tiles": ["message.", "would", "to", "a", "like", "leave", "I"],
              "answer": "I would like to leave a message."
            }
          ]
        },
        {
          "type": "choose",
          "items": [
            {
              "key": "c.u15.l2.p-would",
              "prompt": { "en": "___ you like to come to the fair?" },
              "options": [{ "text": "Are" }, { "text": "Is" }, { "text": "Would" }],
              "answer": 2,
              "why": { "en": "Would you like is a polite invitation.", "hi": "would you like = विनम्र न्योता।" }
            },
            {
              "key": "c.u15.l2.p-to",
              "prompt": { "en": "I would like ___ to Ms Anita, please." },
              "options": [{ "text": "to speak" }, { "text": "speak" }, { "text": "speaking" }],
              "answer": 0,
