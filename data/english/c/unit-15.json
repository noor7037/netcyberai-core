            { "key": "c.u15.l2.s-shop", "model": "I would like a packet of salt, please.", "cue": { "en": "Ask for something politely at a shop." } },
            { "key": "c.u15.l2.s-yes", "model": "Yes, please. Thank you very much!", "cue": { "en": "A friend offers you a sweet. Say yes politely." } }
