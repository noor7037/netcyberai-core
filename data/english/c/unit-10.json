          "examples": [
            { "en": "Every day, Meera goes to the river.", "hi": "मीरा रोज़ नदी पर जाती है।", "time": "now", "pic": "🌊" },
            { "en": "Yesterday, Meera went to the forest.", "hi": "कल मीरा जंगल गई।", "time": "past", "pic": "🌲" },
            { "en": "She saw a monkey in a tall tree.", "hi": "उसने एक ऊँचे पेड़ पर बंदर देखा।", "time": "past", "pic": "🐒" },
