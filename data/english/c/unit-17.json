    {
      "key": "c.u17.l2",
      "kind": "pattern",
      "title": { "en": "was …ing when …", "hi": "जब … तब … कर रहे थे" },
      "minutes": 7,
      "steps": [
        {
          "type": "pattern",
          "title": { "en": "What was happening?", "hi": "क्या हो रहा था?" },
          "visual": "timeline",
          "examples": [
            { "en": "We were decorating the house when Nani arrived.", "hi": "हम घर सजा रहे थे, तभी नानी आ गईं।", "time": "past", "pic": "🎈" },
            {
              "en": "Meera was drawing a rangoli when it started to rain.",
              "hi": "मीरा रंगोली बना रही थी, तभी बारिश शुरू हो गई।",
              "time": "past",
              "pic": "own:rangoli"
            },
            { "en": "What were you doing at eight o'clock?", "hi": "तुम आठ बजे क्या कर रहे थे?", "time": "past", "pic": "⏰" },
            { "en": "I was lighting lamps with Arjun.", "hi": "मैं अर्जुन के साथ दीये जला रही थी।", "time": "past", "pic": "🪔" },
            {
              "en": "The children were flying kites when the music began.",
              "hi": "बच्चे पतंग उड़ा रहे थे, तभी संगीत शुरू हुआ।",
              "time": "past",
              "pic": "own:kite-festival"
            },
            { "en": "Now we are eating sweets together.", "hi": "अब हम साथ में मिठाई खा रहे हैं।", "time": "now", "pic": "🍬" }
          ],
          "note": {
            "en": "was or were + -ing: an action that was going on. when + the past: the short action that happened in the middle.",
            "hi": "was/were + -ing: जो काम चल रहा था। when + बीता समय: जो छोटा काम बीच में हो गया।"
          }
        },
        {
          "type": "build",
          "items": [
            {
              "key": "c.u17.l2.b-cooking",
              "hi": "सलमा खाना बना रही थी, तभी मेहमान आ गए।",
              "pic": "🍲",
              "tiles": ["came.", "Salma", "was", "when", "cooking", "guests", "the"],
              "answer": "Salma was cooking when the guests came."
            },
            {
              "key": "c.u17.l2.b-singing",
              "hi": "हम रात को गाने गा रहे थे।",
              "pic": "🎶",
              "tiles": ["singing", "at", "were", "songs", "night.", "We"],
              "answer": "We were singing songs at night."
            }
          ]
        },
        {
          "type": "choose",
          "items": [
            {
              "key": "c.u17.l2.p-was",
              "prompt": { "en": "Arjun ___ sleeping when the drums started." },
              "options": [{ "text": "was" }, { "text": "were" }, { "text": "is" }],
              "answer": 0,
              "why": { "en": "One person or thing: was + -ing.", "hi": "एक व्यक्ति या चीज़: was + -ing." }
            },
            {
              "key": "c.u17.l2.p-were",
              "prompt": { "en": "We ___ eating when the lights went out." },
              "options": [{ "text": "was" }, { "text": "were" }, { "text": "are" }],
              "answer": 1,
              "why": { "en": "We, you, they or many: were + -ing.", "hi": "we, you, they या कई: were + -ing." }
            }
          ]
        },
