      },
      "steps": [
        {
          "kind": "do",
          "target": "play",
          "expect": "played",
          "say": {
            "en": "Press Play and listen to the poem.",
            "hi": "चलाओ दबाओ और कविता सुनो।"
          }
        },
        {
          "kind": "predict",
          "say": {
            "en": "A poem has beats like a drum. What will you do?",
            "hi": "कविता में ढोल जैसी ताल होती है। तुम क्या करोगे?"
          },
          "options": [
            {
              "id": "clap",
              "en": "Clap with the beat",
              "hi": "ताल पर ताली बजाऊँगा"
            },
            {
              "id": "sleep",
              "en": "Sleep",
              "hi": "सो जाऊँगा"
            },
            {
              "id": "shout",
              "en": "Shout loudly all the time",
              "hi": "लगातार ज़ोर से चिल्लाऊँगा"
            }
          ],
          "answer": "clap"
        },
        {
          "kind": "do",
          "target": "beat",
          "expect": "beat-ok",
          "say": {
            "en": "Tap the big button each time a part of a word lights up.",
            "hi": "शब्द का कोई भाग चमके तो बड़ा बटन दबाओ।"
          }
        },
        {
          "kind": "explain",
          "say": {
            "en": "A poem has a rhythm. When we clap on each part of a word the lines flow like a song. Poems about play and friends are good to clap and sing in a group.",
            "hi": "कविता में लय होती है। शब्द के हर भाग पर ताली बजाने से पंक्तियाँ गीत की तरह बहती हैं। खेल और दोस्तों वाली कविताएँ समूह में ताली बजाकर गाने के लिए अच्छी होती हैं।"
          }
        },
        {
          "kind": "check",
          "items": [
            {
              "q": {
                "en": "What does rhythm in a poem feel like?",
                "hi": "कविता की लय कैसी लगती है?"
              },
              "options": [
                {
                  "en": "Like a regular beat",
                  "hi": "एक नियमित ताल जैसी"
                },
                {
                  "en": "Like silence",
                  "hi": "चुप्पी जैसी"
                },
                {
                  "en": "Like a loud bang",
                  "hi": "ज़ोर की आवाज़ जैसी"
                }
              ],
              "answer": 0,
              "why": {
                "en": "Rhythm is the steady beat of the words.",
                "hi": "लय शब्दों की लगातार चलती ताल है।"
              },
              "wrong": [
                "",
                {
                  "en": "A poem is never silent; it has a beat.",
                  "hi": "कविता चुप नहीं होती; उसमें ताल होती है।"
                },
                {
                  "en": "A bang is a single loud sound, not a pattern.",
                  "hi": "धमाका एक अकेली आवाज़ है, दोहराने वाली ताल नहीं।"
                }
              ]
            }
          ]
        },
        {
          "kind": "explore",
          "say": {
            "en": "Press Play again and clap along with your friends. Make up one more line about evening play.",
            "hi": "फिर चलाओ दबाओ और दोस्तों के साथ ताली बजाओ। शाम के खेल की एक और पंक्ति बनाओ।"
          }
        }
      ]
