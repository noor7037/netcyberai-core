{
  "appId": "com.netcyberai.family",
  "appName": "NetCyberAI Family",
  "webDir": "android-shell/www",
  "server": {
    "url": "https://www.netcyberai.com/family",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "www.netcyberai.com",
      "netcyberai.com"
